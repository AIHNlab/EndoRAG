ENDORAG_OLLAMA_BASE_URL=http://localhost:11434
ENDORAG_OLLAMA_CLOUD_BASE_URL=https://ollama.com
ENDORAG_OLLAMA_API_KEY=
ENDORAG_MAX_RETRIEVAL_ROUNDS=2
ENDORAG_RETRIEVAL_TOP_K=5
# Parent of DiabetesLiterature/, ThyroidLiterature/, ...
ENDORAG_DOCUMENT_ROOT=/path/to/documents
# Parent of qwen3-embedding:8b/chunk_512/...  (usually .../chroma_db)
ENDORAG_CHROMA_ROOT=/path/to/chroma_db
ENDORAG_ARTIFACT_BASE_URL=
OPENAI_API_KEY=
# Use a free GPU; default code fallback is cuda:1 (Ollama often occupies cuda:0).
RERANK_DEVICE=cuda:1
